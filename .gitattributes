# 默认按文本处理，提交时统一转 LF
* text=auto eol=lf

# 明确指定必须用 LF 的文件
*.sh        text eol=lf
gradlew     text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.properties text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# 二进制文件不做任何转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.jar       binary
*.apk       binary
*.zip       binary
*.ttf       binary
*.otf       binary
*.ico       binary
